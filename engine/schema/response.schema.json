{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "MathUniverseResponse v1 (Adenda rectora §7)",
 "type": "object",
 "required": [
  "request_id",
  "api_version",
  "status",
  "elapsed_ms"
 ],
 "properties": {
  "request_id": {
   "type": [
    "string",
    "integer",
    "null"
   ]
  },
  "api_version": {
   "type": "string"
  },
  "status": {
   "enum": [
    "success_exact",
    "success_approximate",
    "unsupported",
    "invalid_input",
    "domain_error",
    "no_solution",
    "multiple_solutions",
    "timeout",
    "cancelled",
    "internal_error"
   ]
  },
  "parsed_input": {
   "type": [
    "object",
    "string",
    "null"
   ]
  },
  "exact_result": {
   "type": [
    "string",
    "null"
   ]
  },
  "approximate_result": {
   "type": [
    "string",
    "null"
   ]
  },
  "conditions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "warnings": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "method": {
   "type": [
    "string",
    "null"
   ]
  },
  "verification": {
   "type": "object",
   "properties": {
    "status": {
     "enum": [
      "passed",
      "failed",
      "not_possible",
      "not_performed"
     ]
    },
    "method": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "data": {
   "type": "object"
  },
  "error": {
   "type": "object",
   "required": [
    "code",
    "message"
   ],
   "properties": {
    "code": {
     "enum": [
      "INVALID_REQUEST",
      "PARSE_ERROR",
      "DOMAIN_ERROR",
      "NOT_IMPLEMENTED",
      "DEPENDENCY_MISSING",
      "LIMIT_EXCEEDED",
      "NOT_SOLVED",
      "VERSION_MISMATCH",
      "INTERNAL_ERROR",
      "TIMEOUT",
      "VERIFICATION_FAILED"
     ]
    },
    "message": {
     "type": "string"
    },
    "details": {
     "type": "object"
    }
   }
  },
  "elapsed_ms": {
   "type": "number"
  }
 }
}